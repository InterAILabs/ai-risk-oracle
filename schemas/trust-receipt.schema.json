{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/InterAILabs/ai-risk-oracle/main/schemas/trust-receipt.schema.json",
  "title": "InterAI Trust Receipt",
  "type": "object",
  "required": [
    "trust_receipt_id",
    "decision_id",
    "issued_at",
    "risk_level",
    "recommended_action"
  ],
  "properties": {
    "trust_receipt_id": {
      "type": "string"
    },
    "decision_id": {
      "type": "string"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "use_case": {
      "type": "string"
    },
    "risk_level": {
      "type": "string"
    },
    "recommended_action": {
      "type": "string"
    },
    "execution_intent_digest": {
      "type": "string",
      "description": "Deterministic digest linking this decision evidence to its evaluated canonical execution intent."
    },
    "execution_intent": {
      "type": "object",
      "description": "Canonical execution intent v2 bound to the decision when the autonomous contract is used."
    },
    "execution_authorization": {
      "type": ["object", "null"],
      "description": "Allow-only, short-lived single-use authorization; external hosts provide durable atomic consumption when required."
    },
    "policy_summary": {
      "type": "object",
      "additionalProperties": true
    },
    "signals": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
