{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/InterAILabs/ai-risk-oracle/main/schemas/verify-request.schema.json",
  "title": "InterAI Autonomous Execution Verify Request",
  "type": "object",
  "required": [
    "use_case",
    "action"
  ],
  "properties": {
    "use_case": {
      "type": "string",
      "examples": [
        "agent-before-tool-execution",
        "agent-before-payment"
      ]
    },
    "action": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "amount_usd": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string"
        },
        "irreversible": {
          "type": "boolean",
          "description": "Declare explicitly. If omitted, the response signal is null and policy requires review."
        },
        "external_side_effect": {
          "type": "boolean",
          "description": "Declare explicitly. If omitted, the response signal is null and policy requires review."
        }
      },
      "additionalProperties": true,
      "oneOf": [
        { "required": ["type", "description"] },
        {
          "required": ["schema", "tool_id", "type", "operation", "arguments", "external_side_effect", "irreversible"],
          "properties": { "schema": { "const": "interai-canonical-action/v1" } }
        }
      ]
    },
    "execution_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "workspace_id", "environment"],
      "properties": {
        "schema": { "const": "interai-host-execution-context/v1" },
        "workspace_id": { "type": "string", "minLength": 1 },
        "environment": { "type": "string", "minLength": 1 },
        "actor_id": { "type": "string", "minLength": 1 },
        "run_id": { "type": "string", "minLength": 1 }
      }
    },
    "authorization_ttl_seconds": { "type": "integer", "minimum": 1, "maximum": 300, "default": 60 },
    "context": {
      "type": "object",
      "properties": {
        "agent_id": {
          "type": "string"
        },
        "environment": {
          "type": "string"
        },
        "counterparty_id": {
          "type": "string"
        },
        "user_confirmation": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "policy": {
      "$ref": "policy.schema.json"
    },
    "domain": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "fast_heuristic",
        "semantic_judge"
      ]
    }
  },
  "additionalProperties": false
}
